{
  "App": {
    "SelfUrl": "https://localhost:44320",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.SmartPantry.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=SmartPantry;Trusted_Connection=True"
  },
  "AuthServer": {
    "Authority": "https://localhost:44320",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "SmartPantry_Swagger",
    "CertificatePassPhrase": "70633738-5a0a-49cb-9963-8659ff2f8e88"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "Z4pMw2aWhyzX4Xon"
  }
}